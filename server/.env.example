PORT=3000

# Deep link utilisé par la page GET / (pont e-mail → app). Doit correspondre au schéma Expo `quizzplus`.
AUTH_DEEP_LINK_TARGET=quizzplus://auth/callback

# Dashboard Supabase → Project Settings → API (même URL que sur la page Data API)
# Ce fichier est chargé APRÈS `.env.local` : si tu définis SUPABASE_URL ici, elle gagne sur EXPO_PUBLIC_SUPABASE_URL.
SUPABASE_URL=https://VOTRE_REF.supabase.co
# Optionnel : timeout fetch vers Supabase (ms). Défaut 30000 (évite le « Connect Timeout 10000ms » d’Undici).
# SUPABASE_FETCH_TIMEOUT_MS=30000
SUPABASE_ANON_KEY=
# Optionnel en local si vous ne testez que register / login / logout / me / Google.
# Obligatoire pour forgot-password, verify-otp, reset-password (et en production).
SUPABASE_SERVICE_ROLE_KEY=

# OTP mot de passe oublié (hash SHA-256 : pepper + code)
# En dev, des valeurs par défaut sont injectées si absentes (ne pas s’en servir en production).
OTP_PEPPER=changez-moi-long-secret-aleatoire

# Jeton opaque signé après verify-otp (HMAC)
RESET_TOKEN_SECRET=autre-secret-long-aleatoire

# Deep link mobile de retour OAuth (doit matcher `app.config.ts` -> scheme).
AUTH_DEEP_LINK_TARGET=quizzplus://auth/callback

# Callback serveur OAuth (utile surtout pour flux web/SSR).
GOOGLE_OAUTH_REDIRECT_URL=http://localhost:3000/api/v1/auth/google/callback
# Optionnel : URL Facebook dédiée. Si absente, GOOGLE_OAUTH_REDIRECT_URL est utilisée.
FACEBOOK_OAUTH_REDIRECT_URL=http://localhost:3000/api/v1/auth/google/callback

# Optionnel : origines CORS séparées par des virgules (défaut * en dev)
# CORS_ORIGINS=http://localhost:8081,http://localhost:19006

# En dev, inclure le code OTP dans la réponse JSON (désactiver en production)
INCLUDE_OTP_IN_RESPONSE=false

# Expéditeur affiché / utilisé par Resend — doit correspondre à un domaine ou expéditeur vérifié chez Resend en production
SMTP_FROM="Quizz+ <noreply@votredomaine.com>"

# Option A — Recommandé sur Render plan gratuit (SMTP sortant bloqué depuis sept. 2025) : API HTTPS Resend
# Créez une clé sur https://resend.com — vérifiez votre domaine et utilisez la même adresse dans SMTP_FROM
# RESEND_API_KEY=re_xxxxxxxx

# Option B — SMTP classique (OK en local, ou sur Render si instance payante autorisant les ports 25/465/587)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=example@gmail.com
# Mot de passe d’application Google (16 car.) : s’il contient des espaces, mettez des guillemets, ex. SMTP_PASS="xxxx xxxx xxxx xxxx"
SMTP_PASS=app-password-ou-token
# Optionnel : e-mail du trésorier (alertes dépôts / retraits via POST /payments/subscribe)
# TREASURER_EMAIL=tresorier@votredomaine.com

# --- Render (production) — service `quizzplus-api` (voir racine `render.yaml`) ---
# URL API : https://quizzplus-api.onrender.com  |  Health : GET /health
# Render injecte PORT ; ne pas le fixer à la main.
#
# Au premier « Apply blueprint », Render demande les clés sync: false (ou les ajouter dans Environment).
# Obligatoire : SUPABASE_URL, SUPABASE_ANON_KEY, SUPABASE_SERVICE_ROLE_KEY,
# OTP_PEPPER (≥16 car.), RESET_TOKEN_SECRET (≥16 car.)
#
# Déjà défini dans le Blueprint (modifiable si le sous-domaine Render change) :
# GOOGLE_OAUTH_REDIRECT_URL=https://quizzplus-api.onrender.com/api/v1/auth/google/callback
# Reporter cette URL dans Supabase → Auth → Redirect URLs (et Google Cloud OAuth si besoin).
#
# Optionnel : CORS_ORIGINS (origines séparées par des virgules).
# AUTH_DEEP_LINK_TARGET est défini dans le Blueprint (quizzplus://auth/callback).
